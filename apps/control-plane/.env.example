# Content Engine control plane (apps/control-plane), deployed as its own Vercel
# project. Every variable the routes read must be named here: the
# check-env-example guard fails the build otherwise. Values never enter git.
#
# Byte-identical with the Control Center project, or the browser's cookie and
# CSRF guards fail across the rewrite (docs/ARCHITECTURE.md, control plane):
ACCESS_CODE=
APP_ORIGIN=https://controlcenter.krishraja.com
VIDEO_STUDIO_CSRF_SECRET=

# Supabase: the mind/make OS project, service role (server-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel cron auth. Every cron in vercel.json accepts `Authorization: Bearer
# $CRON_SECRET`. Leave it UNSET until the Control Center crons are removed:
# an unset secret makes every cron 401 and record nothing, which is the
# only safe state while both projects exist.
CRON_SECRET=

# Models and research providers used by the editorial, brief, shift and Composer routes.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
PERPLEXITY_API_KEY=
NEWSAPI_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
APOLLO_API_KEY=
PEOPLE_DATA_LABS_API_KEY=

# Apify: the creator scout and Challenge-this community scraping.
APIFY_TOKEN=
APIFY_REDDIT_ACTOR=
APIFY_LINKEDIN_ACTOR=

# Read-only cross-project read of the CTRL corroborated headlines pool (feed ingest).
CTRL_SUPABASE_URL=
CTRL_SUPABASE_SERVICE_KEY=

# The n8n content factory webhook Save Draft and the brief push fire.
N8N_CONTENT_FACTORY_WEBHOOK_URL=

# Build signals: the Saturday GitHub read. Which repos may be named in content
# is decided in api/_buildSignals.ts, not here.
GITHUB_TOKEN=
GITHUB_REPOS=krishanraja/control-center,krishanraja/mindmake

# Secret the lens radar accepts alongside CRON_SECRET.
LENS_RADAR_SECRET=

# Google Workspace service account (ops alerts, Drive).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_IMPERSONATE_SUBJECT=
GOOGLE_DRIVE_FOLDER_ID=
OPS_ALERT_EMAIL=

# Video Studio control plane: runner bearer (32+ bytes), receipt signing key
# (32+ bytes), the portable MCP gateway bearer, the candidates export bearer,
# and the private Storage bucket for Before/After proxies.
VIDEO_STUDIO_RUNNER_TOKEN=
VIDEO_STUDIO_RUNNER_SIGNING_KEY=
VIDEO_STUDIO_MCP_TOKEN=
VIDEO_STUDIO_EXPORT_TOKEN=
# Pre-create the bucket as a private Supabase Storage bucket with video/mp4 as
# its sole allowed MIME type and an exact 26214400-byte object limit. Before
# launch, verify single-request object info exposes a quoted or unquoted MD5
# ETag. The runner calls POST /api/video-studio/runner/preview-retention daily;
# it deletes only objects whose 30-day review expiry (or abandoned upload-slot
# expiry) plus seven-day recovery grace has elapsed, through the Storage API.
VIDEO_STUDIO_PREVIEW_BUCKET=

# Injected by Vercel; reported by the health route and the candidates export.
VERCEL_GIT_COMMIT_SHA=
