{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/triage/sweep",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/judge/sweep",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/content-ideas/cluster",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/discover-lens-radar",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/discover-creator-posts",
      "schedule": "0 8 * * 2"
    },
    {
      "path": "/api/feed/ingest",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/content-opportunities/refresh",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/investigations/run",
      "schedule": "0 21 * * 4"
    },
    {
      "path": "/api/shifts/detect",
      "schedule": "30 17 * * 5"
    },
    {
      "path": "/api/arcs/surface",
      "schedule": "50 17 * * 5"
    },
    {
      "path": "/api/briefs/assemble",
      "schedule": "0 18 * * 5"
    },
    {
      "path": "/api/purge/run",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/video-studio/runner/watch",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/content-ideas/archive-stale",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/discover-build-signals",
      "schedule": "0 5 * * 6"
    },
    {
      "path": "/api/learning/compile",
      "schedule": "0 16 * * 0"
    },
    {
      "path": "/api/inspiration/drive-scan",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/trends/entities",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/claims/resolve",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/trends/metrics",
      "schedule": "0 6 * * 6"
    },
    {
      "path": "/api/signals/news",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/signals/odds",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/publish/watch",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/library/recordings/drive-inbox",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "api/content-opportunities/refresh.ts": {
      "maxDuration": 300
    },
    "api/discover-build-signals.ts": {
      "maxDuration": 120
    },
    "api/inspiration/drive-scan.ts": {
      "maxDuration": 300
    },
    "api/aeo/ingest.ts": {
      "maxDuration": 120
    },
    "api/judge/sweep.ts": {
      "maxDuration": 600
    },
    "api/judge/ladder.ts": {
      "maxDuration": 300
    },
    "api/content-ideas/[id]/fact-check.ts": {
      "maxDuration": 300
    },
    "api/content-ideas/[id]/spine-check.ts": {
      "maxDuration": 120
    },
    "api/board/index.ts": {
      "maxDuration": 300
    },
    "api/library/recordings/drive-inbox.ts": {
      "maxDuration": 600
    }
  },
  "rewrites": [
    {
      "source": "/api/board/weeks",
      "destination": "/api/board?op=weeks"
    },
    {
      "source": "/api/board/:week/sources",
      "destination": "/api/board?week=:week&op=sources"
    },
    {
      "source": "/api/board/:week/assets/:id",
      "destination": "/api/board?week=:week&op=assets&id=:id"
    },
    {
      "source": "/api/board/:week/uploads",
      "destination": "/api/board?week=:week&op=uploads"
    },
    {
      "source": "/api/board/:week/posted",
      "destination": "/api/board?week=:week&op=posted"
    },
    {
      "source": "/api/board/:week/imports",
      "destination": "/api/board?week=:week&op=imports"
    },
    {
      "source": "/api/board/:week/:collection/:id",
      "destination": "/api/board?week=:week&collection=:collection&id=:id"
    },
    {
      "source": "/api/board/:week/:collection",
      "destination": "/api/board?week=:week&collection=:collection"
    },
    {
      "source": "/api/board/:week",
      "destination": "/api/board?week=:week"
    },
    {
      "source": "/board/:week",
      "destination": "/api/board?week=:week&op=html"
    },
    {
      "source": "/board",
      "destination": "/api/board?op=latest"
    }
  ]
}
