# An edition's body.md is hashed by the fact gate with LF line endings
# (tests/control-plane/editions.test.ts). Keep it LF on every checkout.
editions/**/*.md text eol=lf

# Stored piece bodies are LF; the writer tests use real ones as fixtures.
tests/fixtures/control-plane/*.md text eol=lf

# Repair evidence includes hashes of the exact JSON bytes. Preserve those bytes
# across Windows and Linux, including transcript and caption-repair documents.
# CRLF is legitimate in these byte-preserved Windows exports; keep the usual
# whitespace checks while treating the CR as part of the line ending.
docs/plans/2026-10-09-friday/repair-evidence-19oct/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# The renderer's source is LF on every checkout, Windows included, so the
# intro sting's approval hash (scripts/quick-edit/intro.py) and every render
# read the same bytes. text=auto lets git's own check leave any binary file
# alone, a type not listed below included (a .lottie is a zip, a .riv a Rive
# file); the lines after this one name the usual ones outright.
apps/renderer/** text=auto eol=lf
apps/renderer/**/*.png binary
apps/renderer/**/*.jpg binary
apps/renderer/**/*.jpeg binary
apps/renderer/**/*.gif binary
apps/renderer/**/*.webp binary
apps/renderer/**/*.ico binary
apps/renderer/**/*.woff binary
apps/renderer/**/*.woff2 binary
apps/renderer/**/*.ttf binary
apps/renderer/**/*.otf binary
apps/renderer/**/*.mp4 binary
apps/renderer/**/*.mov binary
apps/renderer/**/*.webm binary
apps/renderer/**/*.wav binary
apps/renderer/**/*.mp3 binary
apps/renderer/**/*.m4a binary
apps/renderer/**/*.pdf binary
apps/renderer/**/*.lottie binary
apps/renderer/**/*.riv binary
apps/renderer/**/*.avif binary

# Plates and golden frames are hashed byte for byte: never convert line endings.
assets/plates/** -text
fixtures/ve/design-lock/** -text
docs/ve/design/formats/ref/** -text

# makeyourmindup's kill list is pinned by hash (vendor/makeyourmindup/kill-list/SOURCE.md,
# tests/vendor-kill-list.test.ts): never convert its line endings.
vendor/makeyourmindup/kill-list/** -text

# tests/no-claude-routines.test.ts reads the workflows' exact text. Keep them LF on Windows too.
.github/workflows/*.yml text eol=lf

# The live board's client and its built page are compared byte for byte by check:desk-page; LF on Windows too.
apps/control-plane/board-next/** text=auto eol=lf
apps/control-plane/api/board/_deskPage.ts text eol=lf

# Tests match the engine's Python source by its text (tests/control-plane/make-route.test.ts and others); keep it LF on
# Windows too, so a regex over a line break means the same on every runner (full verify red on Windows from 13 Nov).
scripts/**/*.py text eol=lf
