{
  "name": "load-bearing concept tokens (makeyourmindup look, concept stage, not yet approved)",
  "canvas": {"w": 1080, "h": 1920, "safe": {"x0": 90, "x1": 990, "y0": 200, "y1": 1500}, "cover_grid_crop": {"y0": 240, "y1": 1680}},
  "colour": {
    "graphite": "#1A1C1F",
    "graphite_panel_opacity": 0.92,
    "paper": "#F5F5F2",
    "ink": "#15171A",
    "steel": "#8A8F96",
    "hairline": "#3A3E44",
    "dim_overlay": "#1A1C1F",
    "accent": {"mon": "#4C7DFF", "wed": "#FF6B2C", "fri": "#E9D23A"}
  },
  "type": {
    "family": "Fraunces",
    "files": {"upright": "assets/fonts/makeyourmindup/Fraunces-Upright-Variable.ttf", "italic": "assets/fonts/makeyourmindup/Fraunces-Italic-Variable.ttf"},
    "variation": {"SOFT": 0, "WONK": 0},
    "features": "tnum, lnum on every figure, date and time",
    "roles": {
      "why_tag": {"size": 34, "weight": 600, "caps": true, "tracking_em": 0.12},
      "question": {"size": 76, "line": 84, "weight": 560, "max_lines": 3},
      "rail_label": {"size": 30, "line": 34, "weight": 600, "max_lines": 2},
      "plate_note": {"size": 56, "line": 62, "weight": 500},
      "source_line": {"size": 30, "weight": 500},
      "strength_word": {"size": 26, "weight": 650, "small_caps": true, "tracking_em": 0.1},
      "challenger": {"size": 48, "line": 56, "weight": 500, "italic": true},
      "landing_insight": {"size": 64, "line": 72, "weight": 560},
      "landing_question": {"size": 52, "line": 60, "weight": 450, "italic": true},
      "cover_headline": {"size": 112, "line": 116, "weight": 600}
    }
  },
  "strength": {
    "documented": {"stroke": 12, "style": "solid", "node": "filled"},
    "inferred": {"stroke": 4, "style": "solid", "node": "filled-small"},
    "open": {"stroke": 4, "style": "dashed 14/12", "node": "hollow"}
  },
  "rail": {
    "expanded": {"panel_x0": 60, "panel_x1": 330, "spine_x": 112, "label_x0": 146, "label_x1": 318},
    "collapsed": {"panel_x0": 60, "panel_x1": 150, "spine_x": 105},
    "node_diameter": 24,
    "rung_y": [320, 560, 800, 1040, 1280],
    "fork_offset_x": 34,
    "loop": {"stroke": 2, "colour": "steel", "end_dot": 10}
  },
  "motion": {
    "fps": 25,
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "plate_in": {"frames": 10, "translate_y": 40, "fade": true},
    "rail_draw": {"frames": 10},
    "stroke_settle": {"frames": 6},
    "challenger_in": {"frames": 12, "from": "right"},
    "strike_or_park": {"frames": 8},
    "shrink_to_label": {"frames": 10},
    "pull_back": {"frames": 12},
    "push_in_max_scale": 1.03,
    "never": ["bounce", "overshoot", "elastic", "scale-pop", "slap", "typing"]
  },
  "wordmark": {"file": ".scratch/why-ladder/assets/wordmark.png", "width": 170, "anchor": "bottom-right", "x1": 990, "y1": 1490}
}
