{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ve weekly credit budget: Control Center's credit read",
  "description": "Saved by ve budget pull from a get_engine_credits answer for growth-makeyourmindup (Krish, 2026-10-29: credits are \"handled by ai-harness and control-center\"). Never typed by hand and never committed.",
  "type": "object",
  "required": [
    "schema",
    "source",
    "engine_id",
    "held",
    "credits_known",
    "pulled_on",
    "caps",
    "pools",
    "record_sha256"
  ],
  "properties": {
    "schema": {
      "const": "ve-credit-budget/2"
    },
    "source": {
      "type": "string"
    },
    "engine_id": {
      "const": "growth-makeyourmindup"
    },
    "held": {
      "type": "boolean"
    },
    "credits_known": {
      "type": "boolean"
    },
    "pulled_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex_allowance_points",
        "codex_paid_credits",
        "runway_credits",
        "higgsfield_credits",
        "elevenlabs_credits"
      ],
      "properties": {
        "codex_allowance_points": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "codex_paid_credits": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "runway_credits": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "higgsfield_credits": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "elevenlabs_credits": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "pools": {
      "type": "object"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
