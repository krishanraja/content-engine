{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "piece",
    "cut",
    "sha256",
    "lens_sha256",
    "reviewer",
    "reviewed_at",
    "frames_viewed",
    "findings",
    "blocking"
  ],
  "properties": {
    "schema": {
      "const": "ve-verdict/1"
    },
    "piece": {
      "type": "string",
      "minLength": 1
    },
    "cut": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lens_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "string",
      "pattern": "^(?!\\s*[vV][eE]\\s*$).*\\S.*$"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "frames_viewed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at_s"
        ],
        "properties": {
          "at_s": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "area",
          "frame_s",
          "text"
        ],
        "properties": {
          "severity": {
            "enum": [
              "block",
              "fix",
              "note"
            ]
          },
          "area": {
            "enum": [
              "composition",
              "brand",
              "motion",
              "evidence",
              "copy",
              "other"
            ]
          },
          "frame_s": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "blocking": {
      "type": "boolean"
    }
  },
  "if": {
    "properties": {
      "findings": {
        "contains": {
          "properties": {
            "severity": {
              "const": "block"
            }
          },
          "required": [
            "severity"
          ]
        }
      }
    }
  },
  "then": {
    "properties": {
      "blocking": {
        "const": true
      }
    }
  },
  "else": {
    "properties": {
      "blocking": {
        "const": false
      }
    }
  }
}
