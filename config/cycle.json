{
  "_about": "The production cycle's touchpoints, in one place: which system is read or informed at which stage, and how. Krish, 2026-11-26: make sure file archives, divergence engine, strategist, Higgsfield generator, growth-makeyourmindup, makeyourmindup, krish-clone, taste engine, internal auditor, Control Center and humour engine are always involved at the right moments of the production cycle, reading from them or informing them, in the most streamlined way. No other file lists which system is touched when: skills, board prompts (apps/control-plane/api/board/_writeBack.ts) and docs point at a stage. scripts/post-pack/touch.py runs a stage (run), checks it (check), sends what was queued (drain) and lists this file (list). Every touch writes one line to docs/plans/<Monday>-week/touches.jsonl. A stage is complete when every required row is done, queued, or skipped with a reason; exit 2 or not served is skipped, never done.",
  "schema": "cycle/1",
  "from": "config/story-score.json",
  "from_note": "board_feed.py gate (stage 2) and making.py narrative and scripts (stages 5 and 6) report a missing required touch as a finding, code touch, only for weeks on or after the story score's from date.",
  "walls": [
    "Taste is a floor and a writer's steer only; no scorer reads it (tests/story_wall_test.py, check-judges section 4).",
    "Nothing is published, posted, sent or spent without Krish's yes; a paid touch reserves through the chain cap and the story-score ledger first, and is skipped over either.",
    "A headless run with no Control Center key queues its connector touches in the outbox and the week's touch log, so nothing is dropped; drain sends them later.",
    "makeyourmindup copy never names Krish, mind/make or CTRL."
  ],
  "repository": "krishanraja/content-engine",
  "control_center": {
    "url": "https://controlcenter.krishraja.com/api/harness/mcp",
    "url_env": "CC_HARNESS_URL",
    "key_env": "CC_HARNESS_KEY",
    "note": "One JSON-RPC tools/call per touch (control-center api/harness/mcp.ts, _mcp-server.ts). A tool the key's connection is not given (most need one of Krish's own account connections) stays queued with the reason, never done."
  },
  "files": {
    "log": "docs/plans/{week}-week/touches.jsonl",
    "outbox": ".cache/touch/outbox.jsonl"
  },
  "kinds": {
    "script": "an existing CLI in this repository, run as call; exit 0 done, 1 done (flagged), 2 skipped (not served)",
    "gh": "a read of another repository through gh api (call: repo, path; latest: the newest file in a folder)",
    "builtin": "a read touch.py does itself (call: name), reusing the source another script already names",
    "mcp": "a Control Center connector tool (call: tool, arguments); sent when the key is set, else queued",
    "exists": "already done by the code named in cites; the run records it done when the evidence file is there, else skipped with where it is done",
    "manual": "a step only Krish takes; the run records it skipped with the reason"
  },
  "stages": [
    {"id": 0, "name": "Week opens", "when": "Saturday, as the week's run starts"},
    {"id": 1, "name": "Gather", "when": "plan-week step 1, the gather"},
    {"id": 2, "name": "Options and score", "when": "plan-week steps 2 to 7, before the board"},
    {"id": 3, "name": "Board presses", "when": "as Krish presses on the ideas board"},
    {"id": 4, "name": "Research and 5 Whys", "when": "the picked piece's research and why-ladder"},
    {"id": 5, "name": "Narrative lock", "when": "the Sunday room's lock, before he signs"},
    {"id": 6, "name": "Scripts", "when": "make-piece, before making.py scripts"},
    {"id": 7, "name": "Visuals and video", "when": "produce-video, before any paid generation"},
    {"id": 8, "name": "Publish approval", "when": "before the publish page"},
    {"id": 9, "name": "Distribution", "when": "once a piece is out"},
    {"id": 10, "name": "Learn", "when": "Friday or Saturday after the week"}
  ],
  "steps": {
    "_about": "Which stage a board step is (apps/control-plane/api/board/_writeBack.ts reads this to name the stage in a copied prompt).",
    "board": 3, "research": 4, "story": 4, "lock": 5, "scripts": 6, "script": 6, "storyboard": 7, "look": 7, "mock": 7,
    "motion": 7, "video": 7, "publish": 8, "approve": 8, "post": 9
  },
  "rows": [
    {"id": "s0-cc-instruction", "stage": 0, "system": "control-center", "direction": "read",
     "what": "Krish's open instruction for this engine, read before anything else; acknowledged after (s0-cc-ack)",
     "how": {"kind": "mcp", "call": {"tool": "get_engine_instruction", "arguments": {"repository": "{repository}"}}},
     "required": true, "when": null, "evidence": "the tool's answer", "cites": "control-center api/harness/_instruction-mcp.ts"},
    {"id": "s0-cc-ack", "stage": 0, "system": "control-center", "direction": "inform",
     "what": "acknowledge the instruction read in s0-cc-instruction",
     "how": {"kind": "mcp", "call": {"tool": "ack_engine_instruction", "arguments": {"instruction_id": "{instruction_id}", "state": "received", "line": "Read at the start of the week of {week}"}}},
     "required": false, "when": {"vars": ["instruction_id"]}, "evidence": "the ack", "cites": "control-center api/harness/_instruction-mcp.ts"},
    {"id": "s0-cc-brief", "stage": 0, "system": "control-center", "direction": "read",
     "what": "the publication's credits brief, live from its repository",
     "how": {"kind": "mcp", "call": {"tool": "get_engine_brief", "arguments": {"engine": "growth-makeyourmindup"}}},
     "required": false, "when": null, "evidence": "the brief's commit", "cites": "control-center api/harness/_economics-mcp-server.ts"},
    {"id": "s0-strategist-memo", "stage": 0, "system": "strategist", "direction": "read",
     "what": "the strategist's latest memo",
     "how": {"kind": "gh", "call": {"repo": "krishanraja/strategist", "path": "docs/memos", "latest": true}},
     "required": true, "when": null, "evidence": "the memo's path and blob sha", "cites": "gh api repos/krishanraja/strategist/contents/docs/memos"},
    {"id": "s0-growth-reviews", "stage": 0, "system": "growth-makeyourmindup", "direction": "read",
     "what": "growth's latest performance review since last week",
     "how": {"kind": "gh", "call": {"repo": "krishanraja/growth-makeyourmindup", "path": "docs/reviews", "latest": true}},
     "required": true, "when": null, "evidence": "the review's path and blob sha", "cites": "config/story-score.json growth_evidence.source"},
    {"id": "s0-growth-mixlearn", "stage": 0, "system": "growth-makeyourmindup", "direction": "read",
     "what": "growth's mix-learn list, what the channel mix taught",
     "how": {"kind": "gh", "call": {"repo": "krishanraja/growth-makeyourmindup", "path": "lists/mix-learn", "latest": true}},
     "required": false, "when": null, "evidence": "the list's path and blob sha", "cites": "gh api repos/krishanraja/growth-makeyourmindup/contents/lists/mix-learn"},
    {"id": "s0-auditor-open", "stage": 0, "system": "internal-auditor", "direction": "read",
     "what": "the internal auditor's open observations for content-engine",
     "how": {"kind": "manual", "call": {"reason": "no read tool for the internal auditor's open observations yet; its findings reach the engine as Control Center instructions (s0-cc-instruction)"}},
     "required": false, "when": null, "evidence": null, "cites": "control-center api/harness/_mcp-server.ts (record_harness_observation is write only)"},

    {"id": "s1-research-find", "stage": 1, "system": "file-archives", "direction": "read",
     "what": "the research library, per candidate topic, before paying for research",
     "how": {"kind": "mcp", "call": {"tool": "find_research", "arguments": {"query": "{topic}", "repository": "{repository}", "limit": 10}}},
     "required": true, "when": {"vars": ["topic"]}, "evidence": "the hits", "cites": "control-center api/harness/_board-mcp.ts find_research"},
    {"id": "s1-taste-floor", "stage": 1, "system": "taste-engine", "direction": "read",
     "what": "his rejections and feedback cues, as a floor only (refused or not, never a score)",
     "how": {"kind": "script", "call": ["python3", "scripts/post-pack/story_floor.py", "{week}", "--json"]},
     "required": true, "when": {"files": ["{week_dir}/ideas.json"]}, "evidence": "story_floor.py's answer", "cites": "scripts/post-pack/story_floor.py"},
    {"id": "s1-killlist-drift", "stage": 1, "system": "makeyourmindup", "direction": "read",
     "what": "whether makeyourmindup's kill list moved on from the vendored copy",
     "how": {"kind": "builtin", "call": {"name": "killlist_drift", "repo": "krishanraja/makeyourmindup", "path": "quality/panel/kill-list.v1.json", "source": "vendor/makeyourmindup/kill-list/SOURCE.md"}},
     "required": true, "when": null, "evidence": "upstream sha256 against SOURCE.md", "cites": "vendor/makeyourmindup/kill-list/SOURCE.md"},
    {"id": "s1-divergent-record", "stage": 1, "system": "divergence-engine", "direction": "inform",
