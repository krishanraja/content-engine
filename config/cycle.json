    {"id": "s2-divergent-angles", "stage": 2, "system": "divergence-engine", "direction": "read",
     "what": "the angles and the blind judged score",
     "how": {"kind": "exists", "call": {"evidence": "{week_dir}/story/angles.json"}},
     "required": true, "when": null, "evidence": "story/angles.json", "cites": "scripts/post-pack/story_score.py angles"},
    {"id": "s2-divergent-wildcard", "stage": 2, "system": "divergence-engine", "direction": "read",
